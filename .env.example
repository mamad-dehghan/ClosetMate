# --- Auth -------------------------------------------------------------
# Generate with: bun -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Google OAuth (optional, login page hides the button when unset)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Allow the local "dev login" credentials provider.
# Always disabled when NODE_ENV=production unless explicitly set to 1.
ALLOW_DEV_LOGIN=1

# --- Database ---------------------------------------------------------
# Leave empty to use the embedded PGlite database in .data/pglite.
# Set to a Neon/Postgres URL to use a real server.
DATABASE_URL=

# --- Image storage ----------------------------------------------------
# "local" writes to .data/uploads, "blob" uses Vercel Blob.
STORAGE_DRIVER=local
BLOB_READ_WRITE_TOKEN=
